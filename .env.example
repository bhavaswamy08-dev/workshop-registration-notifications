# Copy to ".env" if you want to override defaults (optional - everything has a default).
# Real environment variables always win over values in .env.

# ---- Registration API + worker ----
DATABASE_URL=sqlite:///./data/workshop.db
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8001/notifications

# Retry policy (attempt n fails -> wait min(MAX_DELAY, BASE * 2^(n-1)) seconds, +/- jitter)
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
RETRY_JITTER_RATIO=0.1

# A claimed job must finish within this many seconds, otherwise another worker may take it over.
LEASE_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_SIZE=50
HTTP_CONNECT_TIMEOUT_SECONDS=2
HTTP_REQUEST_TIMEOUT_SECONDS=5

# ---- Mock notification service (separate app, separate database) ----
MOCK_DATABASE_URL=sqlite:///./data/mock_notifications.db
# Initial simulated behaviour (can be changed at runtime through /admin/* endpoints)
MOCK_MODE=normal            # normal | error | timeout
# MOCK_REMAINING=3          # apply the mode to the next N requests only
MOCK_ERROR_STATUS=500
MOCK_TIMEOUT_SECONDS=30
